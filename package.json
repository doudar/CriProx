{
  "name": "skarix",
  "version": "0.20.0",
  "private": true,
  "description": "Open Source Cutting Studio",
  "license": "GPL-3.0-only",
  "author": "Go2Engle",
  "repository": {
    "type": "git",
    "url": "https://github.com/doudar/Skarix.git"
  },
  "homepage": "https://github.com/doudar/Skarix",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "cutter:probe": "node scripts/cutter-probe.cjs",
    "desktop": "npm run build && electron .",
    "desktop:updates": "npm run build && node scripts/update-demo.cjs",
    "package": "npm run build && electron-builder --publish never",
    "package:mac": "npm run build && electron-builder --mac --universal --publish never",
    "package:mac:release": "npm run build && node scripts/package-mac-release.cjs",
    "package:windows": "npm run build && electron-builder --win --x64 --publish never",
    "package:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "format": "prettier --write src tests electron vite.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@tensorflow/tfjs": "~4.11.0",
    "htmlparser2": "^12.0.0",
    "idb-keyval": "^6.2.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.54.0",
    "marked": "^18.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.18.0",
    "snappyjs": "^0.7.0",
    "upscaler": "^1.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@upscalerjs/esrgan-thick": "^1.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "26.16.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.skarix.studio",
    "productName": "Skarix",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "CHANGELOG.md",
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY_LICENSES.txt",
      "!node_modules/@napi-rs/canvas{,/**/*}",
      "!node_modules/@napi-rs/canvas-*/**/*",
      "!electron/update-demo.cjs"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "electron/ai-stdio.cjs",
        "to": "ai-stdio.cjs"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Skarix uses Bluetooth to connect to your selected cutter, read its status, and send cutting jobs.",
        "NSDocumentsFolderUsageDescription": "Skarix accesses the project folders you choose."
      },
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "artifactName": "${productName}-${version}-linux-x64.${ext}",
      "target": [
        "AppImage"
      ]
    },
    "icon": "build/icon.png",
    "nsis": {
      "guid": "911f3104-241d-5d45-b390-b5f4568af6c3"
    }
  }
}
